{
  "name": "Cherysis",
  "displayName": "Cherysis",
  "publisher": "Faye",
  "description": "small tools",
  "version": "0.0.6",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "Cherysis.openToolPanel",
        "title": "Cherysis:打开工具面板"
      }
    ],
    "configuration": {
      "title": "Cherysis",
      "properties": {
        "cherysis.storageDir": {
          "type": "string",
          "default": "",
          "description": "数据存储目录（订单/厂商等库文件存放位置）。留空则使用 VS Code 全局存储目录（%APPDATA%\\Code\\User\\globalStorage\\Faye.Cherysis）。建议填一个绝对路径，设置后不会自动改。"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "Cherysis.openToolPanel"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vsce-pnpm": "^0.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "globby": "^14.1.0",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
