{
  "name": "Cherysis",
  "displayName": "Cherysis",
  "publisher": "Faye",
  "description": "small tools",
  "version": "0.0.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/origin-lang/CherysisTools.git"
  },
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:cherysis.tools",
    "onCommand:Cherysis.openToolPanel",
    "onCommand:Cherysis.openTool"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cherysis",
          "title": "Cherysis 小工具集",
          "icon": "images/cherysis.svg"
        }
      ]
    },
    "views": {
      "cherysis": [
        {
          "type": "tree",
          "id": "cherysis.tools",
          "name": "工具"
        }
      ]
    },
    "commands": [
      {
        "command": "Cherysis.openToolPanel",
        "title": "Cherysis:打开工具面板"
      },
      {
        "command": "Cherysis.openTool",
        "title": "Cherysis:打开指定工具"
      },
      {
        "command": "Cherysis.setShopImageDir",
        "title": "Cherysis:设置商品图片根目录"
      },
      {
        "command": "Cherysis.resetShopImageDir",
        "title": "Cherysis:重置商品图片根目录"
      },
      {
        "command": "Cherysis.setStorageDir",
        "title": "Cherysis:设置商品数据库目录"
      }
    ],
    "configuration": {
      "title": "Cherysis",
      "properties": {
        "cherysis.storageDir": {
          "type": "string",
          "default": "",
          "description": "数据存储目录（商品/采购/订单等库文件存放位置）。留空则使用 VS Code 全局存储目录（%APPDATA%\\Code\\User\\globalStorage\\Faye.Cherysis）。多人共享同一份数据时，所有人的这个值要指向同一个共享目录（如 Z:\\CherysisData）。推荐在工具面板「规则与设置 → 数据库备份/恢复」那一行点「📁 更换…」，或执行命令「Cherysis:设置商品数据库目录」来选文件夹（VS Code 设置界面本身没有文件夹选择器）；也可以直接在这里填写绝对路径。改完需重开工具面板。"
        },
        "cherysis.shopTool.imageDir": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "商品图片根目录（每个商品一个文件夹，内放 {编号}_{序号}.jpg）。这是跟人走的路径：同一份数据库被多人共享时，这里只影响本机，各人各填自己机器上的映射路径（如 Z:\\\\商品图片），互不覆盖。推荐在命令面板执行「Cherysis:设置商品图片根目录」来选文件夹（VS Code 设置界面本身没有文件夹选择器）；也可以直接在这里填写绝对路径。留空则回落到数据库里存的旧值（共享，最后修改的人覆盖所有人）。必须是绝对路径且真实存在，否则本机无法显示/上传/删除图片。改完需重开面板。"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "Cherysis.openToolPanel"
        },
        {
          "command": "Cherysis.openTool",
          "when": "false"
        },
        {
          "command": "Cherysis.setShopImageDir"
        },
        {
          "command": "Cherysis.resetShopImageDir"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile && pnpm run check:parity",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint && pnpm run check:parity",
    "lint": "eslint src",
    "check:parity": "node scripts/check-shopTool-parity.cjs",
    "test": "vscode-test",
    "package": "vsce-pnpm package"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vsce-pnpm": "^0.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "globby": "^14.1.0",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
