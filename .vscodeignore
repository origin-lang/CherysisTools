# .vscode/**
# .vscode-test/**
# src/**
# .gitignore
# .yarnrc
# vsc-extension-quickstart.md
# **/tsconfig.json
# **/eslint.config.mjs
# **/*.map
# **/*.ts
# **/.vscode-test.*



.vscode/**
.vscode-test/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/.vscode-test.*
testData/**
# 排除ts源码，但保留webview静态html资源
src/**/*.ts
src/test/**
!src/webview/**/*
!src/tools/**/fragment.html
!src/tools/**/client.js

# pnpm环境：排除全部node_modules，但是保留生产依赖(xlsx/sharp/better-sqlite3)以及它们在.pnpm内的包
node_modules/**
!node_modules/sharp/**
!node_modules/xlsx/**
!node_modules/better-sqlite3/**
!node_modules/.pnpm/@img+*/**
!node_modules/.pnpm/sharp+*/**
!node_modules/.pnpm/xlsx+*/**
!node_modules/.pnpm/better-sqlite3+*/**
!node_modules/.pnpm/bindings+*/
!node_modules/.pnpm/file-uri-to-path+*/
!node_modules/bindings/**
!node_modules/file-uri-to-path/**
